import mtlf
import sys
import json

config = mtlf.Config()

if len(sys.argv) > 1:
	flags = []
	args = sys.argv[1:]
	for i in range(len(args) - 1, -1, -1):
		if args[i][0] == '-':
			flags.append(args.pop(i))
	if '--help' in flags:
		print('''Usage: mtlf QUERY [[FLAGS]] [FIELD] [ATTR]
QUERY will be matched against FIELD and matching cards printed to stdout.

If FIELD is not specified, its default value is 'name'.

If ATTR is specified, only the specified attribute will be printed.
Ignored unless --json is specified.

If QUERY is not specified, mtlf will open into an interactive mode.

Flags:
	--help:		Print this help text

	--json:		Print the card as raw JSON data instead of pretty
			printing

	--pretty-json:	Converts the JSON data into a python dictionary and
			pretty prints it. Much more human readable than the
			raw JSON, but giving full access to all the available
			data on the card

	--scryfall:	Query Scryfall directly instead of the default mode
			of getting data from ~/.mtlf/data.json. Beware of
			using this in scripts; Scryfall's API is rate limited
			and ignoring rate limits might get your IP blocked.
			Consider using --update instead.

	--update:	Get an up-to-date data.json from Scryfall's API and
			write it to disk.''')
		exit()
	elif "--version" in flags or "-v" in flags:
		print(mtlf.version_string)
		exit()
	else:
		if len(args) > 1:
			field = args[1]
		else:
			field = 'name'
		if len(args) > 2:
			attr = args[2]
		else:
			attr = None
	c = mtlf.make_dict()
	if '--json' in flags:
		print(json.dumps(c.search_json(args)))
	elif '--pretty-json' in flags:
		c.pp.pprint(c.search_json(args))
	else:
		matches = c.search_json(args)
		for match in matches:
			print(mtlf.format_card(match))
			print('---\n')
